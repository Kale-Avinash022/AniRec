# ==============================================================================
# AniRec — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local or cloud settings.
# ==============================================================================

# Application Settings
APP_NAME=AniRec
ENVIRONMENT=development
DEBUG=true

# AI Provider Configuration
# EMBEDDING_PROVIDER options: local | openai
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM_PROVIDER options: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Ingestion Settings
ANILIST_API_URL=https://graphql.anilist.co
ANILIST_MAX_PAGES=60
ANILIST_PER_PAGE=50
ANILIST_RATE_LIMIT_DELAY_SECONDS=0.8

# Retrieval Settings
TOP_K_RETRIEVAL=20
TOP_K_RERANKED=5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
